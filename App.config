<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    
    <!-- Configuración de la aplicación -->
    <appSettings>
        <!-- Ruta de la base de datos (relativa a la carpeta de la aplicación) -->
        <add key="BaseDatos" value="BaseDatos\VentasDB.accdb" />
        
        <!-- Configuración de seguridad -->
        <add key="EncriptarContrasenas" value="true" />
        <add key="IntentosLoginMaximos" value="3" />
        <add key="TiempoBloqueoMinutos" value="15" />
        
        <!-- Configuración de la UI -->
        <add key="TemaAplicacion" value="Claro" />
        <add key="IdiomaPrincipal" value="ES" />
        
        <!-- Configuración de Logging -->
        <add key="ActivarLog" value="true" />
        <add key="RutaLog" value="Logs\" />
        
        <!-- Configuración de Backups -->
        <add key="AutoBackup" value="true" />
        <add key="FrecuenciaBackupDias" value="7" />
    </appSettings>
    
    <!-- Cadena de conexión -->
    <connectionStrings>
        <add name="VentasDB" connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=BaseDatos\VentasDB.accdb" providerName="System.Data.OleDb" />
    </connectionStrings>
    
    <!-- Configuración de runtime -->
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" />
                <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>
